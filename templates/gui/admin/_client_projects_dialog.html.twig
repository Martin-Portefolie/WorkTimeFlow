<dialog id="client_projects_{{ client.id }}" data-testid="client-projects-dialog" data-client-form-target="projectsDialog" data-action="click->client-form#dismissProjects"
        aria-labelledby="client_projects_title_{{ client.id }}" class="client-project-dialog border border-zinc-300 bg-white p-0 text-zinc-900 shadow-xl dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100">
    <header class="flex items-center justify-between gap-4 border-b border-zinc-200 p-4 dark:border-zinc-800">
        <h2 id="client_projects_title_{{ client.id }}" class="text-sm font-medium">{{ client.name }} — {{ 'client.projects'|trans }}</h2>
        <button type="button" data-testid="client-projects-close" autofocus data-action="click->client-form#closeProjects"
                class="border border-zinc-300 px-3 py-1 text-xs dark:border-zinc-700">{{ 'client.close'|trans }}</button>
    </header>
    <div class="space-y-4 p-4">
        {% set groups = [
            {key: 'active', label: 'client.active_projects', items: projects|filter(p => not (p.archived|default(false)))},
            {key: 'inactive', label: 'client.inactive_projects', items: projects|filter(p => p.archived|default(false))}
        ] %}
        {% for group in groups %}
            <section data-testid="client-projects-{{ group.key }}">
                <h3 class="mb-2 text-xs uppercase tracking-wider {{ loop.first ? 'text-emerald-600 dark:text-emerald-400' : 'text-zinc-500' }}">{{ group.label|trans }} ({{ group.items|length }})</h3>
                <ul class="divide-y divide-zinc-200 dark:divide-zinc-800">
                    {% for project in group.items %}
                        <li>
                            <button type="button" data-testid="client-project-open" data-project-id="{{ project.id }}" data-command="p.s {{ project.id }}"
                                    data-action="click->client-form#closeProjects click->gui--admin-gui#runCommand"
                                    class="flex w-full items-center justify-between gap-4 px-2 py-3 text-left text-sm hover:bg-zinc-100 dark:hover:bg-zinc-900">
                                <span>{{ project.name|default('—') }}</span>
                                <span class="text-xs text-zinc-500">#{{ project.id }}</span>
                            </button>
                        </li>
                    {% else %}
                        <li class="py-2 text-xs text-zinc-500">{{ 'client.no_projects'|trans }}</li>
                    {% endfor %}
                </ul>
            </section>
        {% endfor %}
    </div>
</dialog>
