<div class="space-y-4">
    <header class="border border-zinc-800 bg-zinc-950 p-4">
        <div class="text-xs uppercase tracking-[0.3em] text-emerald-400">Overview</div>
        <h1 class="mt-3 text-xl font-bold uppercase text-zinc-100">Admin Dashboard</h1>
        <p class="mt-2 text-zinc-500">
            Terminal-first GUI control panel.
        </p>
    </header>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {% include 'gui/admin/_stat_card.html.twig' with {
            label: 'Clients',
            value: '—',
            command: 'c.l'
        } %}

        {% include 'gui/admin/_stat_card.html.twig' with {
            label: 'Projects',
            value: '—',
            command: 'p.l'
        } %}

        {% include 'gui/admin/_stat_card.html.twig' with {
            label: 'Teams',
            value: '—',
            command: 't.l'
        } %}

        {% include 'gui/admin/_stat_card.html.twig' with {
            label: 'Users',
            value: '—',
            command: 'u.l'
        } %}
    </div>

    <div class="grid gap-4 xl:grid-cols-[1fr_380px]">
        <section class="border border-zinc-800 bg-zinc-950 p-4">
            <h2 class="text-base font-bold uppercase text-zinc-100">Quick Start</h2>
            <p class="mt-2 text-zinc-500">Click actions or use terminal commands.</p>

            <div class="mt-4 grid gap-2 md:grid-cols-2">
                <button data-command="c.l" class="grid grid-cols-[1fr_auto] border border-zinc-800 bg-black px-3 py-2 text-left hover:border-emerald-500/40 hover:text-emerald-400">
                    <span>Open clients</span>
                    <span class="text-emerald-400">c.l</span>
                </button>

                <button data-command="p.l" class="grid grid-cols-[1fr_auto] border border-zinc-800 bg-black px-3 py-2 text-left hover:border-emerald-500/40 hover:text-emerald-400">
                    <span>Open projects</span>
                    <span class="text-emerald-400">p.l</span>
                </button>

                <button data-command="t.a" class="grid grid-cols-[1fr_auto] border border-zinc-800 bg-black px-3 py-2 text-left hover:border-emerald-500/40 hover:text-emerald-400">
                    <span>New team</span>
                    <span class="text-emerald-400">t.a</span>
                </button>

                <button data-command="u.a" class="grid grid-cols-[1fr_auto] border border-zinc-800 bg-black px-3 py-2 text-left hover:border-emerald-500/40 hover:text-emerald-400">
                    <span>New user</span>
                    <span class="text-emerald-400">u.a</span>
                </button>
            </div>
        </section>

        <section class="border border-zinc-800 bg-zinc-950 p-4">
            <h2 class="text-base font-bold uppercase text-zinc-100">System State</h2>
            <div class="mt-4 border border-zinc-800 bg-black p-3 text-xs text-zinc-400">
                active: dashboard<br>
                sync: pending<br>
                source: gui
            </div>
        </section>
    </div>
</div>
