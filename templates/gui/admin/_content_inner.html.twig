{% set view = view|default('overview') %}

{% if view == 'overview' %}

    {% include 'gui/admin/_overview.html.twig' %}

{% elseif view == 'clients/list' %}

    {% include 'gui/admin/_clients_list.html.twig' %}

{% elseif view == 'users/list' %}

    {% include 'gui/admin/_users_list.html.twig' %}

{% elseif view == 'projects/list' %}

    <div class="p-6">
        <div class="mb-4 flex items-center justify-between">
            <div>
                <h2 class="text-lg text-emerald-500 dark:text-emerald-400">
                    {{ data.title|default('Projects') }}
                </h2>

                <p class="mt-1 text-xs text-zinc-500">
                    Showing max 10 rows. Pagination comes next.
                </p>
            </div>

            <span class="text-xs text-zinc-500">
                {{ data.rows|default([])|length }} shown
            </span>
        </div>

        {% include 'gui/admin/components/_table.html.twig' with {
            data: data,
            emptyLabel: 'No projects found.'
        } %}
    </div>

{% elseif view == 'teams/list' %}

    <div class="p-6">
        <div class="mb-4 flex items-center justify-between">
            <div>
                <h2 class="text-lg text-emerald-500 dark:text-emerald-400">
                    {{ data.title|default('Teams') }}
                </h2>

                <p class="mt-1 text-xs text-zinc-500">
                    Showing max 10 rows. Pagination comes next.
                </p>
            </div>

            <span class="text-xs text-zinc-500">
                {{ data.rows|default([])|length }} shown
            </span>
        </div>

        {% include 'gui/admin/components/_table.html.twig' with {
            data: data,
            emptyLabel: 'No teams found.'
        } %}
    </div>

{% elseif view == 'todos/list' or view == 'todos/show' %}

    <div class="p-6">
        <h2 class="mb-4 text-lg text-emerald-500 dark:text-emerald-400">
            {{ data.title|default('Todos') }}
        </h2>

        {% if data.view|default('') == 'error' %}
            <p class="text-sm text-red-500 dark:text-red-400">{{ data.message }}</p>
        {% elseif view == 'todos/list' %}
            <p class="mb-4 text-xs text-zinc-500">
                {{ data.rows|default([])|slice(0, 10)|length }} shown (max 10).
            </p>

            {% include 'gui/admin/components/_table.html.twig' with {
                data: data,
                emptyLabel: 'No todos found.'
            } %}
        {% else %}
            {% include 'gui/admin/components/_details.html.twig' with {
                data: data
            } %}
        {% endif %}
    </div>

{% elseif view == 'timelogs/list' or view == 'timelogs/show' %}

    <div class="p-6">
        <h2 class="mb-4 text-lg text-emerald-500 dark:text-emerald-400">
            {{ data.title|default('Timelogs') }}
        </h2>

        {% if data.view|default('') == 'error' %}
            <p class="text-sm text-red-500 dark:text-red-400">{{ data.message }}</p>
        {% elseif view == 'timelogs/list' %}
            <p class="mb-4 text-xs text-zinc-500">
                {{ data.rows|default([])|slice(0, 10)|length }} shown (max 10).
            </p>

            {% include 'gui/admin/components/_table.html.twig' with {
                data: data,
                emptyLabel: 'No timelogs found.'
            } %}
        {% else %}
            {% include 'gui/admin/components/_details.html.twig' with {
                data: data
            } %}
        {% endif %}
    </div>

{% elseif view == 'clients/show' %}

    {% if data.client is defined %}
        {% include 'gui/admin/_clients_show.html.twig' with {client: data.client} %}
    {% else %}
        <p class="p-4 text-red-500">{{ data.message|default('client.not_found'|trans) }}</p>
    {% endif %}

{% elseif view == 'projects/show' %}

    <div class="p-6">
        <h2 class="mb-4 text-lg text-emerald-500 dark:text-emerald-400">
            {{ data.title|default('Project') }}
        </h2>

        {% include 'gui/admin/components/_details.html.twig' with {
            data: data
        } %}
    </div>

{% elseif view == 'teams/show' %}

    <div class="p-6">
        <h2 class="mb-4 text-lg text-emerald-500 dark:text-emerald-400">
            {{ data.title|default('Team') }}
        </h2>

        {% include 'gui/admin/components/_details.html.twig' with {
            data: data
        } %}
    </div>

{% elseif view == 'users/show' %}

    <div class="p-6">
        <h2 class="mb-4 text-lg text-emerald-500 dark:text-emerald-400">
            {{ data.title|default('User') }}
        </h2>

        {% include 'gui/admin/components/_details.html.twig' with {
            data: data
        } %}
    </div>

{% else %}

    {% include 'gui/admin/_overview.html.twig' %}

{% endif %}
