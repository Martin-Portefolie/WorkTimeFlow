<header class="flex items-center justify-between border-b border-zinc-300 bg-white px-4 py-3 dark:border-zinc-800 dark:bg-black">
    <div>
        <div class="text-xs uppercase tracking-[0.3em] text-emerald-500 dark:text-emerald-400">
            Workspace
        </div>

        <div
            data-gui--admin-gui-target="title"
            class="mt-1 text-sm uppercase text-zinc-900 dark:text-zinc-100"
        >
            {{ active|default('dashboard') }}
        </div>
    </div>

    <div class="flex items-center gap-4 text-xs">
        <button
            type="button"
            class="flex h-9 w-9 items-center justify-center border border-zinc-300 text-zinc-600 transition hover:border-emerald-500 hover:text-emerald-500 dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-emerald-400"
            data-controller="theme-toggle"
            data-action="click->theme-toggle#toggle"
            title="Toggle theme"
        >
            <svg
                data-theme-toggle-target="sun"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="hidden h-5 w-5"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 3v2.25M12 18.75V21M4.22 4.22l1.59 1.59M18.19 18.19l1.59 1.59M3 12h2.25M18.75 12H21M4.22 19.78l1.59-1.59M18.19 5.81l1.59-1.59M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
                />
            </svg>

            <svg
                data-theme-toggle-target="moon"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="h-5 w-5"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 15.002A9.718 9.718 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.267-2.598.75-3.752A9.753 9.753 0 1 0 21.75 15.002Z"
                />
            </svg>
        </button>

        <span class="text-zinc-600 dark:text-zinc-500">
            Logged in as {{ app.user.email }}
        </span>

        <a
            href="{{ path('app_logout') }}"
            class="text-red-500 hover:text-red-400"
        >
            logout
        </a>
    </div>
</header>
