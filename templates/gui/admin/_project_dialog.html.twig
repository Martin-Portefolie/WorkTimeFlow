<dialog id="{{ formId }}_dialog_{{ category }}" data-project-form-target="dialog" data-category="{{ category }}" data-testid="project-dialog-{{ category }}"
        data-action="click->project-form#dismiss" aria-labelledby="{{ formId }}_title_{{ category }}"
        class="client-project-dialog project-dialog border border-zinc-300 bg-white p-0 text-zinc-900 shadow-xl dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100">
    <header class="flex items-center justify-between gap-4 border-b border-zinc-300 p-4 dark:border-zinc-700">
        <h3 id="{{ formId }}_title_{{ category }}">{{ project.name ?: 'project.create'|trans }} — {{ ('project.category.' ~ category)|trans }}</h3>
        <button type="button" data-action="project-form#close" data-testid="project-dialog-close" autofocus class="border border-zinc-300 px-3 py-1 dark:border-zinc-700">{{ 'client.close'|trans }}</button>
    </header>
    <div class="space-y-3 p-4">{% include 'gui/admin/_project_dialog_fields.html.twig' %}</div>
    <footer class="border-t border-zinc-300 p-4 dark:border-zinc-700">
        {% if category != 'todos' %}
            <button type="submit" form="{{ formId }}" data-testid="project-dialog-save" class="border border-emerald-500 px-3 py-1 text-emerald-500">{{ 'company.save'|trans }}</button>
            <span class="ml-2 text-zinc-500">{{ 'project.save_all'|trans }}</span>
        {% endif %}
        <p data-project-form-target="status" data-testid="save-status" role="status" aria-atomic="true" data-state="success" class="form-status">{{ saved|default(false) ? 'company.saved'|trans : '' }}</p>
    </footer>
</dialog>
