<section   data-controller="gui--admin-gui"
    class="grid h-[80vh] grid-rows-[auto_minmax(0,1fr)] overflow-hidden border border-zinc-300 bg-white font-mono text-sm text-zinc-900 dark:border-zinc-800 dark:bg-black dark:text-zinc-300 lg:grid-cols-[280px_1fr] lg:grid-rows-[minmax(0,1fr)]">
    {% include 'gui/admin/_sidebar.html.twig' with {
        active: active|default('dashboard')
    } %}

    <section class="flex min-h-0 min-w-0 flex-col border-l border-zinc-300 bg-white dark:border-zinc-800 dark:bg-black">
        {% include 'gui/admin/_topbar.html.twig' with {
            active: active|default('dashboard')
        } %}

        {% include 'gui/admin/_content.html.twig' with {
            view: view|default('overview')
        } %}
    </section>
</section>
