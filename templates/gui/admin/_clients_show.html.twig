{% set isNew = client.id is null %}
{% set formKey = client.id ?? 'new' %}
<section class="p-4" data-controller="client-form" data-testid="client-details" data-client-id="{{ formKey }}" data-saving="{{ 'company.saving'|trans }}"
         data-error="{{ 'client.save_failed'|trans }}" data-expired="{{ 'client.expired'|trans }}">
    <div class="mb-3 flex items-center justify-between">
        <h2 class="uppercase tracking-wider text-emerald-500">{% if isNew %}{{ 'client.create'|trans }}{% else %}{{ client.name }} #{{ client.id }}{% endif %}</h2>
        <a data-testid="clients-back" href="{{ path('admin_clients_panel') }}" data-action="click->gui--admin-gui#loadClient"
           data-error="{{ 'client.load_failed'|trans }}" class="text-xs text-emerald-500 underline">{{ 'client.back'|trans }}</a>
    </div>
    <form data-testid="client-form" method="post" action="{{ isNew ? path('admin_client_create_panel') : path('admin_client_panel', {id: client.id}) }}" data-turbo="false"
          data-action="submit->client-form#save:prevent">
        <input type="hidden" name="_token" value="{{ csrf_token('client_' ~ formKey) }}">
        <dl class="divide-y divide-zinc-200 border border-zinc-300 text-xs dark:divide-zinc-800 dark:border-zinc-800">
            {% for field in ['name', 'contactPerson', 'contactEmail', 'contactPhone', 'adress', 'postalCode', 'city', 'country'] %}
                <div class="grid grid-cols-[180px_1fr] items-center">
                    <dt class="bg-zinc-100 p-3 text-zinc-500 dark:bg-zinc-950">
                        <label for="client_{{ formKey }}_{{ field }}">{{ ('client.fields.' ~ field)|trans }}</label>
                    </dt>
                    <dd class="min-w-0 p-3">
                        <input data-testid="client-field-{{ field }}" id="client_{{ formKey }}_{{ field }}" name="{{ field }}" value="{{ attribute(client, field) }}"
                               type="{{ field == 'contactEmail' ? 'email' : (field == 'contactPhone' ? 'tel' : 'text') }}"
                               maxlength="{{ field == 'contactPhone' ? 20 : 255 }}"
                               {% if field in ['name', 'contactPerson', 'contactEmail', 'contactPhone'] %}required{% endif %}
                               class="w-full border border-zinc-300 bg-white px-2 py-1 text-zinc-900 dark:border-zinc-700 dark:bg-black dark:text-zinc-100">
                    </dd>
                </div>
            {% endfor %}
        </dl>
        <button type="submit" data-testid="client-save" class="mt-3 border border-emerald-500 px-3 py-1 text-xs text-emerald-500">{{ (isNew ? 'client.create' : 'company.save')|trans }}</button>
        <p data-client-form-target="status" data-testid="save-status" role="status" aria-atomic="true" data-state="success" class="form-status">{{ saved|default(false) ? 'company.saved'|trans : '' }}</p>
    </form>
    {% if not isNew %}
    <div class="mt-3 text-xs text-zinc-500">
        {{ 'client.projects'|trans }}: {{ client.projects|length }}
        {% for project in client.projects %}
            <button type="button" data-testid="client-project-open" data-project-id="{{ project.id }}" data-command="p.s {{ project.id }}" data-action="click->gui--admin-gui#runCommand"
                    class="ml-2 text-emerald-500 underline">{{ project.name }}</button>
        {% endfor %}
    </div>
    {% endif %}
</section>
