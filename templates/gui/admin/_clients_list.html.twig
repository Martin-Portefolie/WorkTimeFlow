<section class="p-4" data-controller="client-list" data-testid="clients-panel">
    <div class="mb-3 flex items-center justify-between">
        <h2 class="uppercase tracking-wider text-emerald-500">{{ 'client.title'|trans }}</h2>
        <button type="button" data-action="click->client-list#add" data-testid="client-create" class="border border-emerald-500 px-3 py-1 text-xs text-emerald-500">{{ 'client.create'|trans }}</button>
    </div>
    <p class="mb-3 text-xs text-zinc-500">{{ 'client.list_help'|trans }}</p>
    <div class="overflow-auto border border-zinc-300 dark:border-zinc-800">
        <table class="w-full text-left text-xs">
            <thead class="border-b border-zinc-300 text-zinc-500 dark:border-zinc-800">
                <tr>
                    {% for field in ['name', 'contactPerson', 'contactEmail', 'contactPhone', 'adress', 'postalCode', 'city', 'country'] %}
                        <th class="p-2 font-normal">{{ ('client.fields.' ~ field)|trans }}</th>
                    {% endfor %}
                    <th class="p-2 font-normal">{{ 'client.projects'|trans }}</th>
                    <th class="p-2 font-normal">{{ 'client.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody data-client-list-target="rows" data-testid="client-rows">
                {% for row in data.rows|default([]) %}
                    {% include 'gui/admin/_client_row.html.twig' with {client: row} %}
                {% endfor %}
                <tr data-client-list-target="empty" data-testid="clients-empty" {% if data.rows|default([])|length %}hidden{% endif %}>
                    <td colspan="10" class="p-3 text-zinc-500">{{ 'client.empty'|trans }}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <template data-client-list-target="newRow">
        {% include 'gui/admin/_client_row.html.twig' with {client: {id: null}} %}
    </template>
</section>
