<section
        class="terminal-shell"
        role="region"
        aria-label="Admin terminal"
        data-controller="terminal--terminal"
        data-action="keydown@window->terminal--terminal#hotkeys"
        data-terminal--terminal-run-url-value="{{ path('admin_terminal_run') }}"
        data-terminal--terminal-allowlist-value='{{ (is_granted("ROLE_ADMIN")
        ? ["help","ping",
            "users:list","users:show","users:add","users:update","users:forgot-password","users:delete", "users:deactivate","users:activate",
            "clients:list","clients:show","clients:add","clients:update","clients:delete"
        ]
        : ["help","ping"]) | json_encode | raw }}'
>
    <div class="flex min-h-[140px] max-h-[300px] items-stretch">

        {# === LEFT (75%) — terminal === #}
        <div class="basis-3/4 min-w-0 border-r border-zinc-800/70 flex flex-col">
            <!-- input row -->
            <div class="px-4 py-3 flex items-center gap-2 shrink-0">
        <span class="text-emerald-400">
          ${{ app.user ? app.user.userIdentifier : 'guest' }}
        </span>
                <input
                        type="text"
                        placeholder="Type a command… hit: ENTER"
                        class="flex-1 bg-transparent outline-none placeholder:text-zinc-500 text-zinc-100 text-[15px]"
                        autocomplete="off"
                        data-terminal--terminal-target="input"
                        data-action="
            keydown.enter->terminal--terminal#submit
            keydown.esc->terminal--terminal#onEsc
            focus->terminal--terminal#focused
            blur->terminal--terminal#blurred"
                >
            </div>

            <div class="term-divider shrink-0"></div>

            <!-- output -->
            <div
                    class="flex-1 overflow-y-auto px-4 py-3 text-xs space-y-1 bg-[#121418] text-zinc-300"
                    data-terminal--terminal-target="output"
                    aria-live="polite">
                {# lines injected by Stimulus #}
            </div>

            <div class="term-divider shrink-0"></div>

            <!-- footer hints -->
            <div class="term-footer">
                <div>Type <span class="text-emerald-400">help</span> to see available commands.</div>
                <div class="term-shortcuts">
    <span class="term-shortcut">
      <img src="{{ asset('icons/keyboard_icons/ctrl_cmd-key.png') }}" class="keycap-img" alt="Ctrl or Cmd">
      <span class="text-xl">+</span>
      <img src="{{ asset('icons/keyboard_icons/forward_slash-key.png') }}" class="keycap-img" alt="/">
      <span>Open command palette</span>
    </span>
                    <span class="term-shortcut">
      <img src="{{ asset('icons/keyboard_icons/upanddown-key.png') }}" class="keycap-img" alt="Up and Down">
      <span>Cycle through previous commands</span>
    </span>
                </div>
            </div>

        </div>

        {# === MIDDLE (15%) — focus tile === #}
        <button
                type="button"
                class="group tile tile-blue basis-[15%] shrink-0"
                data-action="click->terminal--terminal#focusTile"
                aria-label="Focus the terminal"
        >
      <span class="tile-label space-y-1">
        <div>Press</div>
        <div class="flex items-center justify-center gap-1">
          <img class="keycap-img-lg" src="{{ asset('icons/keyboard_icons/ctrl_cmd-key.png') }}" alt="Cmd or Ctrl">
          <span class="text-2xl">+</span>
          <img class="keycap-img-lg" src="{{ asset('icons/keyboard_icons/period-key.png') }}" alt="Period">
        </div>
      </span>
            <span class="tile-sub">focus terminal</span>
        </button>

        {# === RIGHT (10%) — blur tile === #}
        <button
                type="button"
                class="group tile tile-red basis-[10%] shrink-0"
                data-action="click->terminal--terminal#blurTile"
                aria-label="Leave the terminal"
        >
      <span class="tile-label space-y-1">
        <div>Press</div>
        <div>
          <img class="keycap-img-lg" src="{{ asset('icons/keyboard_icons/esc-key.png') }}" alt="Escape key">
        </div>
      </span>
            <span class="tile-sub">leave terminal</span>
        </button>
    </div>

    {# === Command palette (unchanged) === #}
    <div class="fixed inset-0 z-[60] hidden" data-terminal--terminal-target="palette">
        <div class="absolute inset-0 bg-black/50" data-action="click->terminal--terminal#closePalette"></div>
        <div class="absolute left-1/2 top-20 -translate-x-1/2 w-[520px] max-w-[92vw] rounded-xl bg-[#0e1116] ring-1 ring-zinc-800 shadow-xl overflow-hidden">
            <div class="px-3 py-2 border-b border-zinc-800">
                <input
                        type="text"
                        placeholder="Search commands…"
                        class="w-full bg-transparent outline-none placeholder:text-zinc-500 text-zinc-100 text-sm"
                        data-terminal--terminal-target="paletteInput"
                        data-action="input->terminal--terminal#filterPalette keydown.enter->terminal--terminal#pickFirstPalette keydown.esc->terminal--terminal#closePalette"
                >
            </div>
            <div class="max-h-72 overflow-y-auto text-sm" data-terminal--terminal-target="paletteList">
                <!-- items injected -->
            </div>
        </div>
    </div>
</section>
