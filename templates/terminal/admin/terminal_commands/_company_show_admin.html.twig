{# templates/terminal/admin/terminal_commands/_company_show_admin.html.twig #}

{% set company = company ?? null %}
{% set rates   = rates   ?? [] %}

<div class="rounded-md ring-1 ring-zinc-800 overflow-hidden font-mono">
    <table class="table-auto text-xs w-full text-left border-collapse">

        <caption class="text-left px-3 py-2 bg-zinc-900/40 text-zinc-400 text-[11px]">
            {% if company %}
                Our company:
                <span class="font-semibold">
                    {{ company.name ?: '—' }}
                </span>
            {% else %}
                Our company is not initialized yet.
            {% endif %}
        </caption>

        <tbody class="text-zinc-300">

        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500 w-32">
                Company ID
            </td>
            <td class="border border-dotted border-zinc-700 px-3 py-1">
                {{ company ? company.id : '—' }}
            </td>
        </tr>

        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                Name
            </td>
            <td class="border border-dotted border-zinc-700 px-3 py-1 truncate"
                title="{{ company ? (company.name ?: '—') : '' }}">
                {{ company ? (company.name ?: '—') : '—' }}
            </td>
        </tr>

        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                Logo (read-only)
            </td>
            <td class="border border-dotted border-zinc-700 px-3 py-1 truncate"
                title="{{ company and company.logo ? company.logo : '' }}">
                {% if company and company.logo %}
                    {{ company.logo }}
                {% else %}
                    <span class="text-zinc-600">—</span>
                {% endif %}
            </td>
        </tr>

        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500 align-top">
                Rates
            </td>
            <td class="border border-dotted border-zinc-700 px-3 py-1">

                {% if not company %}
                    <div class="text-zinc-600">
                        Company not initialized. Use <span class="term-cmd">company:set-name</span> first.
                    </div>
                {% else %}
                    {% if rates is empty %}
                        <div class="text-zinc-600">
                            No rates yet. Use <span class="term-cmd">rates:add</span> to create one.
                        </div>
                    {% else %}
                        <div class="text-[11px] text-zinc-500 mb-1">
                            {{ rates|length }} rate{{ rates|length == 1 ? '' : 's' }}:
                        </div>

                        <table class="w-full border-collapse text-[11px] text-left">
                            <thead class="bg-zinc-900/40 text-zinc-500">
                            <tr>
                                <th class="border border-dotted border-zinc-700 px-2 py-1 w-12">ID</th>
                                <th class="border border-dotted border-zinc-700 px-2 py-1">Name</th>
                                <th class="border border-dotted border-zinc-700 px-2 py-1 w-24 text-right">Value</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for r in rates %}
                                <tr>
                                    <td class="border border-dotted border-zinc-700 px-2 py-1 text-zinc-400">
                                        {{ r.id }}
                                    </td>
                                    <td class="border border-dotted border-zinc-700 px-2 py-1 truncate"
                                        title="{{ r.name }}">
                                        {{ r.name ?: '—' }}
                                    </td>
                                    <td class="border border-dotted border-zinc-700 px-2 py-1 text-right">
                                        {{ r.value ?: '—' }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                {% endif %}
            </td>
        </tr>

        </tbody>
    </table>
</div>
