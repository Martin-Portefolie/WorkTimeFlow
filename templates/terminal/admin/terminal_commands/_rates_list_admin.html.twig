{# templates/terminal/admin/terminal_commands/_rates_list_admin.html.twig #}

<div class="space-y-2 font-mono text-xs">

    <div class="text-xs uppercase tracking-wide text-zinc-500">
        Rates{% if companyName %} for {{ companyName }}{% endif %}
    </div>

    <div class="flex items-center justify-between text-[11px] text-zinc-500">
        <div>
            <span class="text-zinc-500">Total shown:</span> {{ rows|length }}
        </div>
    </div>

    {% if rows is empty %}
        <div class="text-zinc-600 text-[11px]">
            No rates yet. Use <span class="term-cmd">rates:add</span> to create one.
        </div>
    {% else %}
        <div class="rounded-md ring-1 ring-zinc-800 overflow-hidden">
            <table class="table-auto w-full text-left text-xs border-collapse">
                <thead class="bg-zinc-900/40 text-zinc-500">
                <tr>
                    <th class="border border-dotted border-zinc-700 px-3 py-1 w-12">ID</th>
                    <th class="border border-dotted border-zinc-700 px-3 py-1">Name</th>
                    <th class="border border-dotted border-zinc-700 px-3 py-1 w-24 text-right">Value</th>
                </tr>
                </thead>
                <tbody class="text-zinc-300">
                {% for r in rows %}
                    <tr class="hover:bg-zinc-900/40">
                        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-400">
                            {{ r.id }}
                        </td>
                        <td class="border border-dotted border-zinc-700 px-3 py-1 truncate"
                            title="{{ r.name }}">
                            {{ r.name ?: '—' }}
                        </td>
                        <td class="border border-dotted border-zinc-700 px-3 py-1 text-right">
                            {{ r.value ?: '—' }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
