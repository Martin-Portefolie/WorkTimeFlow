{# templates/terminal/admin/terminal_commands/_clients_show_admin.html.twig #}

{% set addr = [
    client.adress ?? null,
    [client.postalCode, client.city]|filter(v => v)|join(' ') ?: null,
    client.country ?? null
]|filter(v => v)|join(', ') %}

{% set projects = client.projects ?? [] %}

<div class="rounded-md ring-1 ring-zinc-800 overflow-hidden font-mono">
    <table class="table-auto text-xs w-full text-left border-collapse">

        <caption class="text-left px-3 py-2 bg-zinc-900/40 text-zinc-400 text-[11px]">
            Client details for <span class="font-semibold"> {{ client.name ?? '—' }} </span> with id: <span class="font-semibold">{{ client.id ?? '—' }} </span>
        </caption>

        <tbody class="text-zinc-400">

        {# row #}


        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">Client address:</td>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">{{ addr ?: '—' }}</td>
        </tr>

        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">Client contact person:</td>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">{{ client.contactPerson ?? '—' }}</td>
        </tr>

        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">Client contact email:</td>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500 break-words">{{ client.contactEmail ?? '—' }}</td>
        </tr>

        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">Client contact phone:</td>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">{{ client.contactPhone ?? '—' }}</td>
        </tr>

        {# Projects #}
        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500 align-top">Client projects:</td>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                ( {{ projects|length }} )
            </td>
        </tr>

        {% if projects|length > 0 %}
            {% for p in projects %}
                <tr>
                    <td class="border border-dotted border-zinc-700 px-3 py-1 pl-8 text-zinc-500">
                        project: {{ p.id }}:
                    </td>
                    <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                        {{ p.name ?? '—' }}
                    </td>
                </tr>
            {% endfor %}
        {% else %}
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 pl-8 text-zinc-500"></td>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-600">none</td>
            </tr>
        {% endif %}

        </tbody>
    </table>
</div>
