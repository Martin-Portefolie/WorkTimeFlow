{# expects: project, client, rate, teams #}

<table class="table-auto w-full text-xs text-left font-mono border-collapse">
    <caption class="text-emerald-300 text-sm px-3 py-2">
        Project created (#{{ project.id }})
    </caption>

    <tbody class="text-zinc-300">
    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 w-32 text-zinc-500">
            Name
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1">
            {{ project.name }}
        </td>
    </tr>
    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
            Client
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1">
            {% if client %}
                #{{ client.id }} — {{ client.name }}
            {% else %}
                <span class="text-zinc-600 text-[11px]">None</span>
            {% endif %}
        </td>
    </tr>
    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
            Priority
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1">
            {{ project.priority.name|capitalize }}
        </td>
    </tr>
    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
            Deadline
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-[11px] text-zinc-400">
            {% if project.deadline %}
                {{ project.deadline|date('d/m/Y') }}
            {% else %}
                <span class="text-zinc-600">None set.</span>
            {% endif %}
        </td>
    </tr>
    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
            Estimated time
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1">
            {% if project.estimatedMinutes is not null %}
                {% set h = (project.estimatedMinutes // 60) %}
                {% set m = (project.estimatedMinutes % 60) %}
                {{ h }}h {{ m }}m
                <span class="text-zinc-500 text-[11px]">
                    ({{ project.estimatedMinutes }} min)
                </span>
            {% else %}
                <span class="text-zinc-600 text-[11px]">No estimate.</span>
            {% endif %}
        </td>
    </tr>
    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
            Estimated budget
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1">
            {% if project.estimatedBudget is not null %}
                {{ project.estimatedBudget }}
            {% else %}
                <span class="text-zinc-600 text-[11px]">None.</span>
            {% endif %}
        </td>
    </tr>
    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
            Rate
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1">
            {% if rate %}
                {{ rate.name }}
                <span class="text-zinc-500 text-[11px]">
                    — {{ rate.value }} / hour
                </span>
            {% else %}
                <span class="text-zinc-600 text-[11px]">No rate linked.</span>
            {% endif %}
        </td>
    </tr>
    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
            Teams
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1">
            {% if teams is empty %}
                <span class="text-zinc-600 text-[11px]">No teams attached.</span>
            {% else %}
                <ul class="list-disc list-inside space-y-0.5 text-[11px] text-zinc-300">
                    {% for t in teams %}
                        <li title="{{ t.name }}">
                            #{{ t.id }} — {{ t.name }}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </td>
    </tr>
    </tbody>
</table>
