{# expects: team, project (or null), users (array<User>) #}

<table class="table-auto w-full text-xs text-left font-mono border-collapse">
    <caption class="text-emerald-300 text-sm px-3 py-2">
        Team created (#{{ team.id }})
    </caption>

    <tbody class="text-zinc-300">
    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500 w-32">
            Team name
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1">
            {{ team.name }}
        </td>
    </tr>
    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
            Project
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1 truncate"
            title="{{ project ? project.name : '' }}">
            {% if project %}
                {{ project.name }}
            {% else %}
                <span class="text-zinc-600 text-[11px]">None (no project linked)</span>
            {% endif %}
        </td>
    </tr>
    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500 align-top">
            Users
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1">
            {% if users is empty %}
                <span class="text-zinc-600 text-[11px]">No users attached.</span>
            {% else %}
                <ul class="list-disc list-inside space-y-0.5 text-[11px] text-zinc-300">
                    {% for u in users %}
                        <li title="{{ u.email }}">
                            #{{ u.id }} — {{ u.userIdentifier }} &lt;{{ u.email }}&gt;
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </td>
    </tr>
    </tbody>
</table>
