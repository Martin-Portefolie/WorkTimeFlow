{# templates/terminal/admin/terminal_commands/_users_list_admin.html.twig #}

<div class="space-y-2">
    <div class="text-xs uppercase tracking-wide text-zinc-500">
        Users
    </div>

    <div class="flex items-center justify-between text-[11px] text-zinc-500">
        <div>
            <span class="text-zinc-500">Total shown:</span> {{ rows|length }}
            <span class="mx-2 text-zinc-700">•</span>
            <span class="text-zinc-500">Limit:</span> {{ limit }}

            {% if q %}
                <span class="mx-2 text-zinc-700">•</span>
                <span class="text-zinc-500">Filter:</span>
                <code class="term-flag">--q={{ q }}</code>
            {% endif %}

            <span class="mx-2 text-zinc-700">•</span>
            <span class="text-zinc-500">Active filter:</span>

            {% if activeFlagRaw is not null %}
                <code class="term-flag">--is-active={{ activeFlagRaw }}</code>
            {% else %}
                <span class="text-zinc-600 text-[10px] italic">
                    {% if isActive is same as(false) %}
                        inactive only
                    {% elseif isActive is null %}
                        all (active + inactive)
                    {% else %}
                        active only (default)
                    {% endif %}
                </span>
            {% endif %}
        </div>
    </div>

    {% if rows is empty %}
        <div class="mt-2 text-[12px] text-zinc-500">
            No users found.
        </div>
    {% else %}
        <div class="rounded-md ring-1 ring-zinc-800 overflow-hidden font-mono tabular-nums">
            <table class="table-auto w-full text-xs text-left border-collapse">
                <caption class="text-left px-3 py-2 bg-zinc-900/40 text-zinc-500 text-[11px]">
                    User list
                </caption>

                <thead class="text-zinc-500">
                <tr>
                    <th class="border border-dotted border-zinc-700 px-3 py-1 w-10 font-normal">
                        Id
                    </th>
                    <th class="border border-dotted border-zinc-700 px-3 py-1 font-normal">
                        Email
                    </th>
                    <th class="border border-dotted border-zinc-700 px-3 py-1 font-normal">
                        Username
                    </th>
                    <th class="border border-dotted border-zinc-700 px-3 py-1 font-normal">
                        Roles
                    </th>
                    <th class="border border-dotted border-zinc-700 px-3 py-1 w-20 font-normal">
                        Active
                    </th>
                </tr>
                </thead>

                <tbody class="text-zinc-500">
                {% for r in rows %}
                    <tr>
                        <td class="border border-dotted border-zinc-700 px-3 py-1">
                            {{ r.id }}
                        </td>

                        <td class="border border-dotted border-zinc-700 px-3 py-1 truncate break-words" title="{{ r.email }}">
                            {{ r.email ?: '—' }}
                        </td>

                        <td class="border border-dotted border-zinc-700 px-3 py-1 truncate" title="{{ r.username }}">
                            {{ r.username ?: '—' }}
                        </td>

                        <td class="border border-dotted border-zinc-700 px-3 py-1 truncate break-words" title="{{ r.roles }}">
                            {{ r.roles ?: '—' }}
                        </td>

                        <td class="border border-dotted border-zinc-700 px-3 py-1">
                            {% if r.active is same as(true) %}
                                <span class="text-emerald-400">active</span>
                            {% elseif r.active is same as(false) %}
                                <span class="text-zinc-600">inactive</span>
                            {% else %}
                                <span class="text-zinc-700">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
