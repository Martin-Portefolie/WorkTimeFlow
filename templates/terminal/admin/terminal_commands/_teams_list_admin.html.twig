{# groups: [ { projectName: string, teams: [ {id,name,userCount,projectNames[]} ] } ] #}

<div class="space-y-4 font-mono text-xs">
    <div class="text-[13px] text-zinc-300 font-semibold">
        Teams grouped by project
    </div>

    {% if groups is empty %}
        <div class="text-zinc-600 text-[11px]">
            No teams yet. Use <span class="term-cmd">teams:add</span> to create one.
        </div>
    {% else %}
        {% for group in groups %}
            <div class="rounded-md ring-1 ring-zinc-800 overflow-hidden">
                <table class="table-auto w-full text-left border-collapse">
                    <caption class="bg-zinc-900/40 text-zinc-400 uppercase tracking-wide p-2 text-left">
                        Project:
                        <span class="text-zinc-200 font-semibold">
                            {{ group.projectName }}
                        </span>
                    </caption>

                    <thead class="bg-zinc-900/40 text-zinc-500">
                    <tr>
                        <th class="border border-dotted border-zinc-700 px-2 py-1 w-14">ID</th>
                        <th class="border border-dotted border-zinc-700 px-2 py-1">Team name</th>
                        <th class="border border-dotted border-zinc-700 px-2 py-1 w-20 text-right">
                            Users
                        </th>
                        <th class="border border-dotted border-zinc-700 px-2 py-1">Other projects</th>
                    </tr>
                    </thead>

                    <tbody class="text-zinc-300">
                    {% for t in group.teams %}
                        {% set otherProjects = t.projectNames|filter(p => p != group.projectName) %}
                        <tr class="hover:bg-zinc-900/40">
                            <td class="border border-dotted border-zinc-700 px-2 py-1 text-zinc-400">
                                {{ t.id }}
                            </td>
                            <td class="border border-dotted border-zinc-700 px-2 py-1 truncate"
                                title="{{ t.name }}">
                                {{ t.name }}
                            </td>
                            <td class="border border-dotted border-zinc-700 px-2 py-1 text-right">
                                {{ t.userCount }}
                            </td>
                            <td class="border border-dotted border-zinc-700 px-2 py-1 text-zinc-500 truncate"
                                title="{{ otherProjects is empty ? '' : otherProjects|join(', ') }}">
                                {% if otherProjects is empty %}
                                    <span class="text-zinc-700 text-[11px]">—</span>
                                {% else %}
                                    {{ otherProjects|join(', ') }}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endfor %}
    {% endif %}
</div>
