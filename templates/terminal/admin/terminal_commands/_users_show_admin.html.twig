{# templates/terminal/admin/terminal_commands/_users_show_admin.html.twig #}

{% set roles = user.roles ?? [] %}
{% set rolesLabel = roles|length ? roles|join(', ') : '—' %}

{# we assume the entity exposes an "isActive" property/getter #}
{% set isActive = user.isActive ?? null %}

{% set teams = user.teams ?? [] %}
{% set timelogs = user.timelogs ?? [] %}

<div class="rounded-md ring-1 ring-zinc-800 overflow-hidden font-mono">
    <table class="table-auto text-xs w-full text-left border-collapse">

        <caption class="text-left px-3 py-2 bg-zinc-900/40 text-zinc-400 text-[11px]">
            User details for
            <span class="font-semibold">{{ user.username ?? '—' }}</span>
            (<span class="font-mono">{{ user.email ?? '—' }}</span>)
            with id:
            <span class="font-semibold">{{ user.id ?? '—' }}</span>
        </caption>

        <tbody class="text-zinc-400">

        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500 w-32">
                Username:
            </td>
            <td class="border border-dotted border-zinc-700 px-3 py-1">
                {{ user.username ?? '—' }}
            </td>
        </tr>

        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                Email:
            </td>
            <td class="border border-dotted border-zinc-700 px-3 py-1 break-words">
                {{ user.email ?? '—' }}
            </td>
        </tr>

        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500 align-top">
                Roles:
            </td>
            <td class="border border-dotted border-zinc-700 px-3 py-1 break-words">
                {{ rolesLabel }}
            </td>
        </tr>

        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                Active:
            </td>
            <td class="border border-dotted border-zinc-700 px-3 py-1">
                {% if isActive is same as(true) %}
                    <span class="text-emerald-400">active</span>
                {% elseif isActive is same as(false) %}
                    <span class="text-zinc-600">inactive</span>
                {% else %}
                    <span class="text-zinc-700">unknown</span>
                {% endif %}
            </td>
        </tr>

        {# Optional: basic relation counts, matching the "projects" idea for clients #}
        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                Teams:
            </td>
            <td class="border border-dotted border-zinc-700 px-3 py-1">
                ( {{ teams|length }} )
            </td>
        </tr>

        <tr>
            <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                Timelogs:
            </td>
            <td class="border border-dotted border-zinc-700 px-3 py-1">
                ( {{ timelogs|length }} )
            </td>
        </tr>

        </tbody>
    </table>
</div>
