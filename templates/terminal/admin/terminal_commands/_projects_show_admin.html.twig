{# templates/terminal/admin/terminal_commands/_projects_show_admin.html.twig #}

<div class="space-y-3 font-mono text-xs">
    <div class="text-[13px] text-zinc-300 font-semibold">
        Project details
    </div>

    {# === BASIC INFO === #}
    <div class="rounded-md ring-1 ring-zinc-800 overflow-hidden">
        <table class="table-auto w-full border-collapse text-xs">
            <tbody class="text-zinc-300">
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 w-32 text-zinc-500">
                    ID
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1">
                    {{ project.id }}
                </td>
            </tr>
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                    Name
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1 truncate"
                    title="{{ project.name }}">
                    {{ project.name }}
                </td>
            </tr>
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500 align-top">
                    Description
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-2">
                    {% if project.description %}
                        <div class="whitespace-pre-wrap text-zinc-300">
                            {{ project.description }}
                        </div>
                    {% else %}
                        <span class="text-zinc-600 text-[11px]">No description.</span>
                    {% endif %}
                </td>
            </tr>
            </tbody>
        </table>
    </div>

    {# === CLIENT / RELATIONS === #}
    <div class="rounded-md ring-1 ring-zinc-800 overflow-hidden">
        <table class="table-auto w-full border-collapse text-xs">
            <tbody class="text-zinc-300">
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 w-32 text-zinc-500">
                    Client
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1">
                    {% if summary.clientId %}
                        #{{ summary.clientId }} — {{ summary.clientName }}
                    {% else %}
                        <span class="text-zinc-600 text-[11px]">None</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                    Rate
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1">
                    {% if summary.rateName %}
                        {{ summary.rateName }}
                        {% if summary.rateValue is not null %}
                            <span class="text-zinc-500 text-[11px]">
                                — {{ summary.rateValue }} / hour
                            </span>
                        {% endif %}
                    {% else %}
                        <span class="text-zinc-600 text-[11px]">No rate linked.</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                    Teams
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1">
                    {% set teams = project.teams %}
                    {% if teams is empty %}
                        <span class="text-zinc-600 text-[11px]">
                            No teams attached. Use
                            <span class="term-cmd">projects:add-team {{ project.id }} &lt;teamId|name&gt;</span>
                            to attach one.
                        </span>
                    {% else %}
                        <ul class="list-disc list-inside space-y-0.5 text-[11px]">
                            {% for t in teams %}
                                <li title="{{ t.name }}">
                                    #{{ t.id }} — {{ t.name }}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </td>
            </tr>
            </tbody>
        </table>
    </div>

    {# === TIME / PLANNING === #}
    <div class="rounded-md ring-1 ring-zinc-800 overflow-hidden">
        <table class="table-auto w-full border-collapse text-xs">
            <tbody class="text-zinc-300">
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 w-32 text-zinc-500">
                    Priority
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1">
                    {{ summary.priority|capitalize }}
                </td>
            </tr>
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                    Deadline
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-[11px]
                           {% if summary.deadlineExpired %}text-red-400{% else %}text-zinc-400{% endif %}">
                    {% if summary.deadlineFormatted %}
                        {{ summary.deadlineFormatted }}
                        {% if summary.deadlineExpired %}
                            <span class="ml-1 uppercase tracking-wide">expired</span>
                        {% endif %}
                    {% else %}
                        <span class="text-zinc-600">None set.</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                    Estimated time
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1">
                    {% if summary.estimatedLabel %}
                        {{ summary.estimatedLabel }}
                        <span class="text-zinc-500 text-[11px]">
                            ({{ summary.estimatedMinutes }} min)
                        </span>
                    {% else %}
                        <span class="text-zinc-600 text-[11px]">No estimate.</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                    Time used
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1">
                    {{ summary.totalUsedLabel }}
                    <span class="text-zinc-500 text-[11px]">
                        ({{ summary.totalMinutesUsed }} min)
                    </span>
                </td>
            </tr>
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                    Remaining time
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1
                           {% if summary.isOverrun %}text-red-400{% endif %}">
                    {% if summary.remainingLabel is not null %}
                        {{ summary.remainingLabel }}
                        {% if summary.isOverrun %}
                            <span class="ml-1 text-[10px] uppercase tracking-wide">
                                over budget
                            </span>
                        {% endif %}
                    {% else %}
                        <span class="text-zinc-600 text-[11px]">No estimate.</span>
                    {% endif %}
                </td>
            </tr>
            </tbody>
        </table>
    </div>

    {# === STATUS / META === #}
    <div class="rounded-md ring-1 ring-zinc-800 overflow-hidden">
        <table class="table-auto w-full border-collapse text-xs">
            <tbody class="text-zinc-300">
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 w-32 text-zinc-500">
                    Todos
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1">
                    {{ summary.todosCount }}
                </td>
            </tr>
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                    Archived
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1">
                    {% if summary.isArchived %}
                        <span class="px-1 py-0.5 rounded bg-zinc-800/80 text-amber-300 text-[10px] uppercase">
                            archived
                        </span>
                    {% else %}
                        <span class="text-zinc-400 text-[11px]">No</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                    Paid
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1">
                    {% if summary.isPaid %}
                        <span class="px-1 py-0.5 rounded bg-zinc-800/80 text-emerald-300 text-[10px] uppercase">
                            paid
                        </span>
                    {% else %}
                        <span class="text-zinc-400 text-[11px]">No</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
                    Last updated
                </td>
                <td class="border border-dotted border-zinc-700 px-3 py-1 text-[11px] text-zinc-400">
                    {% if summary.lastUpdatedFormatted %}
                        {{ summary.lastUpdatedFormatted }}
                    {% else %}
                        <span class="text-zinc-600">Unknown</span>
                    {% endif %}
                </td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
