{# templates/terminal/admin/terminal_commands/_users_created_summary.html.twig #}

<table class="table-auto w-full text-xs text-left font-mono border-collapse">
    <caption class="text-emerald-300 text-sm px-3 py-2">
        User created (#{{ id }})
    </caption>

    <tbody class="text-zinc-300">

    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500 w-32">
            Username:
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1">
            {{ username ?: '—' }}
        </td>
    </tr>

    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
            Email:
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1 break-words">
            {{ email ?: '—' }}
        </td>
    </tr>

    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
            Roles:
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1 break-words">
            {{ roles ?: '—' }}
        </td>
    </tr>

    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
            Password:
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1">
            {{ passwordLabel ?: '(not shown)' }}
        </td>
    </tr>

    <tr>
        <td class="border border-dotted border-zinc-700 px-3 py-1 text-zinc-500">
            Notification:
        </td>
        <td class="border border-dotted border-zinc-700 px-3 py-1">
            {{ notifyLabel ?: 'not sent' }}
        </td>
    </tr>

    </tbody>
</table>
