<div class="space-y-3 text-[13px]">
    <div class="font-semibold text-zinc-200">Here are the available admin commands</div>

    <div class="font-medium text-zinc-200">Admin commands</div>
    <ul class="list-disc pl-5 space-y-1">
        {% for item in aliases %}
            <li>
                <span class="term-cmd">{{ item.cmd }}</span>
                <span class="text-zinc-600"> | </span>
                <span class="term-alias">{{ item.alias }}</span>
                {% if item.note %}
                    <span class="term-note">— {{ item.note }}</span>
                {% endif %}
            </li>
        {% endfor %}
    </ul>




    <div class="mt-3 text-[12px] text-zinc-400">
        Shortcuts:
        <span class="term-kbd">⌘/Ctrl + \</span> focus,
        <span class="term-kbd">⌘/Ctrl + .</span> palette,
        <span class="term-kbd">↑/↓</span> history,
        <span class="term-kbd">Ctrl/⌘ + L</span> clear.
    </div>
</div>
