<div class="space-y-3">

    <div class="font-mono text-[13px] text-zinc-100 font-semibold">
        Here are the available admin commands
    </div>

    <div class="rounded-lg ring-1 ring-zinc-800 overflow-hidden">
        <div class="bg-zinc-900/40  uppercase tracking-wide text-zinc-400">
            Admin commands
        </div>

        <ul class="divide-y divide-zinc-800">
            {%- for it in aliases -%}
                <li class="px-3 py-2 text-sm">
                    <div class="flex items-baseline flex-wrap gap-2">
                        <code class="text-emerald-400">{{ it.cmd }} {{ it.usage }}</code>
                        <span class="text-zinc-600 text-xs">|</span>
                        <code class="text-zinc-400">{{ it.alias }}</code>
                        <span class="text-zinc-500 text-xs">— {{ it.desc }}</span>
                    </div>

                    {% if it.flags is not empty %}
                        <div class="flex flex-wrap items-center mt-1 ml-5 text-[10px] text-amber-300">
                            {% for flag in it.flags %}
                                <code class="bg-zinc-800/60 px-1 py-0.5 rounded leading-tight tracking-tight">
                                    {{ flag }}
                                </code>
                                {% if not loop.last %}
                                    <span class="text-zinc-600 mx-1"> | </span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </li>
            {%- endfor -%}
        </ul>
    </div>

</div>
