<div class="flex items-start gap-2" data-await="{{ await ? '1' : '0' }}">
    {% if success %}
        <span class="text-green-400 font-mono">&gt;</span>
    {% else %}
        <span class="text-red-400 font-mono">&gt;</span>
    {% endif %}

    <div class="flex-1 space-y-1">
        {% if input|length %}
            <div class="text-zinc-200 font-mono text-sm">{{ input }}</div>
        {% endif %}
        <div class="text-zinc-400 text-xs whitespace-normal">{{ output|raw }}</div>

    </div>
</div>
