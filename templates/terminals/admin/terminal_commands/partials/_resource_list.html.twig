{# ========================================================= #}
{# Resource list                                             #}
{# ========================================================= #}

<div class="space-y-3">
    <div class="flex items-start justify-between gap-4">
        <div>
            <h3 class="text-sm font-semibold text-zinc-100">
                {{ title|default(resource|default('Resource')|title) }}
            </h3>

            {% if description is defined and description %}
                <p class="mt-1 text-xs text-zinc-500">
                    {{ description }}
                </p>
            {% endif %}
        </div>

        {% if rows is defined %}
            <div class="shrink-0 rounded-full border border-zinc-800 bg-zinc-950/70 px-2.5 py-1 text-[11px] text-zinc-400">
                {{ rows|length }} result{{ rows|length == 1 ? '' : 's' }}
            </div>
        {% endif %}
    </div>

    <div class="overflow-x-auto rounded-xl border border-zinc-800 bg-[#0e1116]">
        <table class="min-w-full border-collapse text-left text-xs">
            <thead class="border-b border-zinc-800 bg-zinc-950/70 text-zinc-400">
            <tr>
                {% for column in columns %}
                    <th class="whitespace-nowrap px-3 py-2 font-medium">
                        {{ column.label }}
                    </th>
                {% endfor %}
            </tr>
            </thead>

            <tbody class="divide-y divide-zinc-800/80">
            {% for row in rows %}
                <tr class="transition hover:bg-zinc-900/70">
                    {% for column in columns %}
                        {% set value = row[column.key] ?? null %}

                        <td class="whitespace-nowrap px-3 py-2 text-zinc-300">
                            {% if value is same as(true) %}
                                <span class="text-emerald-400">yes</span>
                            {% elseif value is same as(false) %}
                                <span class="text-red-400">no</span>
                            {% elseif value is iterable %}
                                <span class="text-zinc-300">
                                        {{ value|join(', ') }}
                                    </span>
                            {% elseif value is empty %}
                                <span class="text-zinc-600">—</span>
                            {% else %}
                                {{ value }}
                            {% endif %}
                        </td>
                    {% endfor %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="{{ columns|length }}" class="px-3 py-6 text-center text-zinc-500">
                        No results found.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
