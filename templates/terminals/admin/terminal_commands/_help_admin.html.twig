{# templates/terminal/admin/terminal_commands/_help_admin.html.twig #}

<div class="space-y-4 font-mono">

    <div class="text-[13px] text-zinc-300 font-semibold">
        Here are the available admin commands
    </div>

    {# --- Split aliases into users / clients / company / rates / teams --- #}
    {% set userCommands = [] %}
    {% set clientCommands = [] %}
    {% set companyCommands = [] %}
    {% set rateCommands = [] %}
    {% set teamCommands = [] %}

    {% for commandItem in aliases %}
        {% if commandItem.cmd starts with 'users:' %}
            {% set userCommands = userCommands|merge([commandItem]) %}
        {% elseif commandItem.cmd starts with 'clients:' %}
            {% set clientCommands = clientCommands|merge([commandItem]) %}
        {% elseif commandItem.cmd starts with 'company:' %}
            {% set companyCommands = companyCommands|merge([commandItem]) %}
        {% elseif commandItem.cmd starts with 'rates:' %}
            {% set rateCommands = rateCommands|merge([commandItem]) %}
        {% elseif commandItem.cmd starts with 'teams:' %}
            {% set teamCommands = teamCommands|merge([commandItem]) %}
        {% endif %}
    {% endfor %}

    {# ---------- USER COMMANDS TABLE ---------- #}
    {% if userCommands is not empty %}
        <table class="border-collapse border border-zinc-800 w-full text-xs">
            <caption class="bg-zinc-900/40 text-zinc-400 uppercase tracking-wide p-2 text-left">
                User commands
            </caption>

            <thead>
            <tr class="bg-zinc-900/40 text-zinc-500">
                <th class="border border-zinc-800 px-2 py-1 text-left w-[22%]">Command</th>
                <th class="border border-zinc-800 px-2 py-1 text-left w-[10%]">Alias</th>
                <th class="border border-zinc-800 px-2 py-1 text-left w-[18%]">Usage</th>
                <th class="border border-zinc-800 px-2 py-1 text-left w-[30%]">Description</th>
                <th class="border border-zinc-800 px-2 py-1 text-left w-[20%]">Flags</th>
            </tr>
            </thead>

            <tbody>
            {% for commandItem in userCommands %}
                <tr class="text-zinc-300">
                    <td class="border border-zinc-800 px-2 py-1">
                        <code class="text-emerald-400">{{ commandItem.cmd }}</code>
                    </td>

                    <td class="border border-zinc-800 px-2 py-1">
                        <code class="text-amber-300">{{ commandItem.alias }}</code>
                    </td>

                    <td class="border border-zinc-800 px-2 py-1 text-zinc-500">
                        {% if commandItem.usage %}
                            <code class="text-zinc-400">{{ commandItem.usage }}</code>
                        {% else %}
                            <span class="text-zinc-700">—</span>
                        {% endif %}
                    </td>

                    <td class="border border-zinc-800 px-2 py-1 text-zinc-500">
                        {{ commandItem.desc }}
                    </td>

                    <td class="border border-zinc-800 px-2 py-1">
                        {% if commandItem.flags is not empty %}
                            <div class="flex flex-col gap-0.5">
                                {% for flag in commandItem.flags %}
                                    <code class="text-sky-400 bg-zinc-800/60 px-1 py-0.5 rounded text-[10px]">
                                        {{ flag }}
                                    </code>
                                {% endfor %}
                            </div>
                        {% else %}
                            <span class="text-zinc-700 text-[10px]">—</span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {# ---------- CLIENT COMMANDS TABLE ---------- #}
    {% if clientCommands is not empty %}
