<table class="border-collapse border border-zinc-800 w-full text-xs">
    <caption class="p-2 text-left">Timelog commands</caption>
    <thead><tr><th>Command</th><th>Alias</th><th>Usage</th><th>Flags</th></tr></thead>
    <tbody>
    {% for item in aliases|filter(item => item.cmd starts with 'timelogs:') %}
        <tr><td>{{ item.cmd }}</td><td>{{ item.alias }}</td><td>{{ item.usage }}</td><td>{{ item.flags|join(' ') }}</td></tr>
    {% endfor %}
    </tbody>
</table>
