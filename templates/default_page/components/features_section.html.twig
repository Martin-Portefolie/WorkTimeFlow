<section
    class="bg-slate-50 py-16"
    aria-labelledby="features-title"
>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        {# Section heading #}
        <div class="mx-auto mb-10 max-w-3xl text-center">
            <h2
                id="features-title"
                class="text-3xl font-black tracking-[-0.03em] text-slate-900 sm:text-4xl"
            >
                {{ 'default_page.features.title'|trans }}
            </h2>

            <p class="mt-4 text-lg leading-8 text-slate-600">
                {{ 'default_page.features.subtitle'|trans }}
            </p>
        </div>

        {# Feature cards #}
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">

            {% set features = [
                {
                    title: 'default_page.features.items.command.title',
                    desc: 'default_page.features.items.command.desc',
                    icon: 'M8 9l3 3-3 3M13 15h3M4 6h16v12H4z'
                },
                {
                    title: 'default_page.features.items.time.title',
                    desc: 'default_page.features.items.time.desc',
                    icon: 'M12 8v5l3 3M21 12A9 9 0 1 1 3 12a9 9 0 0 1 18 0z'
                },
                {
                    title: 'default_page.features.items.team.title',
                    desc: 'default_page.features.items.team.desc',
                    icon: 'M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0M21 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75'
                },
                {
                    title: 'default_page.features.items.analytics.title',
                    desc: 'default_page.features.items.analytics.desc',
                    icon: 'M3 3v18h18M7 13v5M11 9v9M15 11v7M19 6v12'
                }
            ] %}

            {% for feature in features %}
                <article class="group rounded-2xl border border-emerald-100 bg-white p-8 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-xl hover:shadow-emerald-900/10">
                    <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-lg shadow-emerald-900/20">
                        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="{{ feature.icon }}"/>
                        </svg>
                    </div>

                    <h3 class="text-xl font-bold text-slate-900">
                        {{ feature.title|trans }}
                    </h3>

                    <p class="mt-4 text-base leading-7 text-slate-600">
                        {{ feature.desc|trans }}
                    </p>
                </article>
            {% endfor %}

        </div>
    </div>
</section>
