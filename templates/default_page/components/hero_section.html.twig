<section
    class="relative overflow-hidden bg-gradient-to-b from-emerald-50/70 via-white to-white"
    aria-labelledby="hero-title"
>
    <div class="mx-auto max-w-7xl px-4 pt-20 pb-16 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl text-center">

            {# Hero badge #}
            <div class="inline-flex items-center gap-3 rounded-full border border-emerald-200 bg-emerald-200 px-5 py-2.5 text-emerald-800 shadow-sm shadow-emerald-900/10">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="h-8 w-8 shrink-0"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10">
                        <path d="M12.5 18.5v-7H16l-.5 3h-8l-.5-3h3.5v7"/>
                        <path d="M11.5 18.5h-4l-3-3.25V9l7-4.5m0 14h4l3-3.25V9l-7-4.5m0-4v2m11 9h-2m.25-8.25L19 5m1.75 15.25L19 18.5m-18.5-7h2m-.25-8.25L4 5M2.25 20.25L4 18.5m4.5 0v2h3m3-2v2h-3m-2 0v2h2m2-2v2h-2m0 1v-1"/>
                    </g>
                </svg>

                <span class="text-xl font-bold tracking-tight">
                            {{ 'default_page.hero.pill'|trans }}
                        </span>
            </div>

            {# Hero title #}
            <h1
                id="hero-title"
                class="mt-6 bg-gradient-to-r from-emerald-950 via-emerald-700 to-teal-400 bg-clip-text text-5xl font-black tracking-[-0.05em] text-transparent sm:text-6xl lg:text-7xl"
            >
                {{ 'default_page.hero.title'|trans }}
            </h1>

            {# Hero subtitle #}
            <article class="mx-auto mt-6 max-w-4xl">
                <p class="text-lg leading-8 text-slate-600">
                    {{ 'default_page.hero.subtitle'|trans }}
                </p>
            </article>

        </div>
    </div>
</section>
