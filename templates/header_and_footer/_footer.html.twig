<footer class="mt-16 border-t border-emerald-200/80 bg-white/90 text-slate-900 shadow-sm backdrop-blur-md dark:border-slate-800 dark:bg-slate-950/90 dark:text-slate-100">
    <div class="mx-auto max-w-7xl px-6 py-14 lg:px-8">
        <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">

            {# Contact #}
            <section class="text-left">
                <h2 class="mb-4 text-lg font-semibold text-slate-900 dark:text-white">
                    {{ 'footer.contact.title'|trans }}
                </h2>

                <div class="space-y-1 text-sm leading-6">
                    <p class="text-base">{{ 'footer.contact.project'|trans }}</p>
                    <p>{{ 'footer.contact.address'|trans }}</p>
                    <p>
                        {{ 'footer.contact.email_label'|trans }}
                        <a href="mailto:n1tramkr1st1ansen@gmail.com"
                           class="underline text-emerald-700 transition hover:text-emerald-600 dark:text-emerald-400 dark:hover:text-emerald-300">
                            n1tramkr1st1ansen@gmail.com
                        </a>
                    </p>
                </div>
            </section>

            {# Technologies #}
            <section class="text-left">
                <h2 class="mb-6 text-lg font-semibold text-slate-900 dark:text-white">
                    {{ 'footer.tech.title'|trans }}
                </h2>

                <div class="grid w-full max-w-[320px] grid-cols-4 gap-6">
                    <a href="https://github.com"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="flex items-center justify-center">
                        <img src="{{ asset('icons/logos/github.svg') }}"
                             alt="GitHub"
                             class="h-12 w-12 object-contain">
                    </a>

                    <a href="https://symfony.com"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="flex items-center justify-center">
                        <img src="{{ asset('icons/logos/symfony.svg') }}"
                             alt="Symfony"
                             class="h-12 w-12 object-contain">
                    </a>

                    <a href="https://stimulus.hotwired.dev"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="flex items-center justify-center">
                        <img src="{{ asset('icons/logos/stimulus-icon.svg') }}"
                             alt="Stimulus"
                             class="h-12 w-12 object-contain">
                    </a>

                    <a href="https://turbo.hotwired.dev"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="flex items-center justify-center">
                        <img src="{{ asset('icons/logos/turbopack.svg') }}"
                             alt="Turbo"
                             class="h-12 w-12 object-contain">
                    </a>

                    <a href="https://developer.mozilla.org/en-US/docs/Web/JavaScript"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="flex items-center justify-center">
                        <img src="{{ asset('icons/logos/javascript.svg') }}"
                             alt="JavaScript"
                             class="h-12 w-12 object-contain">
                    </a>

                    <a href="https://www.docker.com"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="flex items-center justify-center">
                        <img src="{{ asset('icons/logos/docker.svg') }}"
                             alt="Docker"
                             class="h-12 w-12 object-contain">
                    </a>

                    <a href="https://www.php.net/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="flex items-center justify-center">
                        <img src="{{ asset('icons/logos/php.svg') }}"
                             alt="PHP"
                             class="h-12 w-12 object-contain">
                    </a>

                    <a href="https://getcomposer.org/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="flex items-center justify-center">
                        <img src="{{ asset('icons/logos/composer.svg') }}"
                             alt="Composer"
                             class="h-12 w-12 object-contain">
                    </a>
                </div>
            </section>

            {# Open Source #}
            <section class="text-left">
                <h2 class="mb-4 text-lg font-semibold text-slate-900 dark:text-white">
                    {{ 'footer.oss.title'|trans }}
                </h2>

                <div class="space-y-1 text-sm leading-6">
                    <p>{{ 'footer.oss.description'|trans }}</p>
                    <p>
                        {{ 'footer.oss.released_under_prefix'|trans }}
                        <a href="https://opensource.org/licenses/MIT"
                           class="underline text-emerald-700 transition hover:text-emerald-600 dark:text-emerald-400 dark:hover:text-emerald-300">
                            {{ 'footer.oss.mit_license'|trans }}
                        </a>.
                    </p>
                    <p>
                        {{ 'footer.oss.contribute_prefix'|trans }}
                        <a href="https://github.com/worktimeflow"
                           class="underline text-emerald-700 transition hover:text-emerald-600 dark:text-emerald-400 dark:hover:text-emerald-300">
                            {{ 'footer.oss.github'|trans }}
                        </a>.
                    </p>
                </div>
            </section>

            {# Contribute #}
            <section class="text-left">
                <h2 class="mb-4 text-lg font-semibold text-slate-900 dark:text-white">
                    {{ 'footer.contrib.title'|trans }}
                </h2>

                <p class="mb-5 text-sm leading-6">
                    {{ 'footer.contrib.desc'|trans }}
                </p>

                <a href="https://github.com/sponsors/worktimeflow"
                   class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow transition hover:bg-emerald-700">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="1em"
                         height="1em"
                         viewBox="0 0 16 16"
                         aria-hidden="true">
                        <path fill="#fff" d="M7.984 14q-.217 0-.409-.077a1.3 1.3 0 0 1-.369-.236l-.73-.671Q4.24 11.012 2.62 9.18Q1 7.35 1 5.43q0-1.453.994-2.441q.995-.99 2.445-.989q.85 0 1.784.436C6.845 2.727 7.438 3.142 8 4c.59-.858 1.189-1.273 1.798-1.564Q10.711 2 11.561 2q1.45 0 2.445.989q.994.988.994 2.44q0 1.967-1.7 3.823A59 59 0 0 1 9.526 13l-.747.687a1.15 1.15 0 0 1-.794.313z"/>
                    </svg>
                    {{ 'footer.contrib.cta'|trans }}
                </a>
            </section>
        </div>

        <div class="mt-12 border-t border-emerald-200/80 pt-6 text-center dark:border-slate-800">
            <p class="text-xs text-slate-500 dark:text-slate-400">
                {{ 'footer.legal.copyright'|trans({
                    '%year%': 'now'|date('Y'),
                    '%brand%': 'WorkTimeFlow'
                }) }}
            </p>
        </div>
    </div>
</footer>
